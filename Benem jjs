local function removeEsp(player)
    if espHighlights[player] then
        espHighlights[player]:Destroy()
        espHighlights[player] = nil
    end
end

local function addEsp(player)
    if player == LocalPlayer then return end
    
    local function applyHighlight(char)
        removeEsp(player)
        if not espEnabled then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "BenemEspHighlight"
        highlight.Adornee = char
        highlight.FillColor = Color3.fromRGB(0, 150, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Parent = char
        
        espHighlights[player] = highlight
    end
    
    player.CharacterAdded:Connect(applyHighlight)
    if player.Character then
        applyHighlight(player.Character)
    end
end

EspToggleSwitch.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if espEnabled then
        TweenService:Create(EspToggleSwitch, tweenInfo, {BackgroundColor3 = Color3.fromRGB(0, 120, 255)}):Play()
        TweenService:Create(EspToggleCircle, tweenInfo, {Position = UDim2.new(1, -20, 0.5, 0)}):Play()
        for _, p in ipairs(Players:GetPlayers()) do
            addEsp(p)
        end
    else
        TweenService:Create(EspToggleSwitch, tweenInfo, {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
        TweenService:Create(EspToggleCircle, tweenInfo, {Position = UDim2.new(0, 2, 0.5, 0)}):Play()
        for p, _ in pairs(espHighlights) do
            removeEsp(p)
        end
    end
end)

Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        addEsp(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    removeEsp(player)
end)

