RunService.RenderStepped:Connect(function(dt)
    if isOrbiting and currentTargetPart then
        if not currentTargetPart:IsDescendantOf(Workspace) or (currentTargetHum and currentTargetHum.Health <= 0) then
            resetTarget()
            return
        end
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            orbitAngle = orbitAngle + dt * 1000000
            local radius = 5
            local offset = Vector3.new(math.cos(orbitAngle) * radius, 1.5, math.sin(orbitAngle) * radius)
            char.HumanoidRootPart.CFrame = CFrame.new(currentTargetPart.Position + offset, currentTargetPart.Position)
        end
    end
end)

