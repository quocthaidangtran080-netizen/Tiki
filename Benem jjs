-- TÍCH HỢP CLICK XOAY / AUTO KILL CỰC NHANH VÀO NÚT "Obirt"
-- ========================================================
local isOrbiting = false
local orbitAngle = 0
local currentTargetPart = nil
local currentTargetHum = nil

local function resetTarget()
	currentTargetPart = nil
	currentTargetHum = nil
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
		Camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	end
end

Mouse.Button1Down:Connect(function()
	if isOrbiting and Mouse.Target then
		local hitModel = Mouse.Target:FindFirstAncestorOfClass("Model")
		if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= LocalPlayer.Character then
			currentTargetPart = Mouse.Target
			currentTargetHum = hitModel:FindFirstChildOfClass("Humanoid")
			if currentTargetHum then
				Camera.CameraSubject = currentTargetHum
			end
		end
	end
end)

